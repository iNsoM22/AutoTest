# Application environment: development | production | test
AUTOTEST_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
AUTOTEST_LOG_LEVEL=INFO

# Optional override for application data directory (defaults to OS-specific user data dir)
# AUTOTEST_DATA_DIR=

# Optional override for SQLite database filename inside the data directory
AUTOTEST_DB_FILENAME=autotest.db

# Browser defaults for dedicated Chromium session
AUTOTEST_BROWSER_HEADLESS=false
AUTOTEST_BROWSER_SLOW_MO_MS=0
AUTOTEST_BROWSER_DEFAULT_TIMEOUT_MS=30000

# SQLite operational defaults
AUTOTEST_SQLITE_WAL_MODE=true
AUTOTEST_EVENT_BATCH_SIZE=50
